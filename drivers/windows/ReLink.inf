; Independently authored ReLink virtual audio package. See PROVENANCE.md.
[Version]
Signature="$WINDOWS NT$"
Class=MEDIA
ClassGuid={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
DriverVer=10/23/2026,0.1.0.0
CatalogFile=ReLink.cat
PnpLockdown=1

[Manufacturer]
%Provider%=ReLink,NTamd64.10.0...19041

[ReLink.NTamd64.10.0...19041]
%DeviceName%=ReLink.Device,Root\RaveLinkAudio

[DestinationDirs]
DefaultDestDir=13

[SourceDisksNames]
1=%MediaName%

[SourceDisksFiles]
ReLink.sys=1

[ReLink.Device.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=ReLink.Copy

[ReLink.Copy]
ReLink.sys

[ReLink.Device.NT.Services]
AddService=RaveLinkAudio,0x00000002,ReLink.Service

[ReLink.Service]
DisplayName=%DeviceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\ReLink.sys

[ReLink.Device.NT.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%,Wave,ReLink.Wave
AddInterface=%KSCATEGORY_RENDER%,Wave,ReLink.Wave
AddInterface=%KSCATEGORY_CAPTURE%,Wave,ReLink.Wave
AddInterface=%KSCATEGORY_REALTIME%,Wave,ReLink.Wave
AddInterface=%KSCATEGORY_AUDIO%,Topology,ReLink.Topology
AddInterface=%KSCATEGORY_TOPOLOGY%,Topology,ReLink.Topology

[ReLink.Wave]
AddReg=ReLink.Wave.Registry

[ReLink.Topology]
AddReg=ReLink.Topology.Registry

[ReLink.Wave.Registry]
HKR,,CLSID,,%KSProxy%
HKR,,FriendlyName,,%CableName%

[ReLink.Topology.Registry]
HKR,,CLSID,,%KSProxy%
HKR,,FriendlyName,,%CableName%

[Strings]
Provider="Textual"
DeviceName="ReLink Virtual Audio"
CableName="ReLink Cable 1"
MediaName="ReLink driver package"
KSProxy="{17cca71b-ecd7-11d0-b908-00a0c9223196}"
KSCATEGORY_AUDIO="{6994ad04-93ef-11d0-a3cc-00a0c9223196}"
KSCATEGORY_RENDER="{65e8773e-8f56-11d0-a3b9-00a0c9223196}"
KSCATEGORY_CAPTURE="{65e8773d-8f56-11d0-a3b9-00a0c9223196}"
KSCATEGORY_REALTIME="{eb115ffc-10c8-4964-831d-6dcb02e6f23f}"
KSCATEGORY_TOPOLOGY="{dda54a40-1e4c-11d1-a050-405705c10000}"
